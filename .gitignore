/tmp
/out-tsc

/dist

/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.pnp
.pnp.js

# 内置编译器的大资源（约 91MB，由 scripts/fetch-engine.mjs 从固定 Release 下载）
/public/engine/clang22-noeh
/public/engine/lld22-noeh
/public/engine/sysroot22.tar

# 内置 Python 运行时（由 scripts/fetch-pyodide.mjs 下载）
/public/engine/pyodide

.vscode/*
# IDE 本地状态，不进版本库
.idea/

# Python 脚本的缓存
__pycache__/

# Archify 架构图生成产物（本地留存，不进版本库）
/.archify/

# 用户敏感数据（PTA 账号、模型密钥等），不提交到版本库
/test_data.txt
/test_login_state.json

# 本地调试用的浏览器用户目录（会带 Cookie / 登录态）
/testDir/
